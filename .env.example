# Replace every CHANGE_ME with your own value. Never commit the real .env.
# The server needs the DB_* and JWT_* variables. ADMIN_* is only for `create-admin`
# and TEST_DB_NAME is only for the test suite; production does not need them.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=vehicles
TEST_DB_NAME=vehicles_test
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=30
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
# Optional settings (defaults shown):
# CORS_ORIGINS=          # comma separated origins; empty = CORS disabled
# DOCS_ENABLED=true      # set false in production to hide /docs, /redoc, /openapi.json
